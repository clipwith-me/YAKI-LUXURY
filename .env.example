# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/yaki"

# Canonical public origin — used for canonical URLs, sitemap, Open Graph and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to salt anonymous visitor hashes (analytics/attribution). 32+ random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# File storage: "local" writes to ./storage (dev only). Production should implement the S3 driver.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Notification drivers. "log" writes a redacted line to the server log instead of sending.
EMAIL_DRIVER="log"
SMS_DRIVER="log"
WHATSAPP_DRIVER="log"

# Seed: initial super-admin (used by `npm run db:seed`). Change the password immediately.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Disposable database for `npm test` (it is wiped on every run). Must differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/yaki_test"
